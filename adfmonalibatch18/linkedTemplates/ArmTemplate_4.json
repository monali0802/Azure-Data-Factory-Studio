					"elapsedTimeMetric": {}
				},
				"parameters": {
					"tablelist": {
						"type": "array",
						"defaultValue": [
							{
								"TableName": "mara",
								"TableSchemaName": "dbo",
								"WaterMark_Column": "last_updated"
							},
							{
								"TableName": "vbap",
								"TableSchemaName": "dbo",
								"WaterMark_Column": "last_updated"
							},
							{
								"TableName": "vbrk",
								"TableSchemaName": "dbo",
								"WaterMark_Column": "last_updated"
							}
						]
					}
				},
				"folder": {
					"name": "Onehub lake"
				},
				"annotations": []
			},
			"dependsOn": []
		},
