{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfmonalibatch18"
		},
		"ls_adls_monali_batch18_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_monali_batch18'"
		},
		"ls_source_db_monali_batch18_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_source_db_monali_batch18'"
		},
		"ls_adls_monali_batch18_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsmonaligbatch18.dfs.core.windows.net/"
		},
		"ls_source_db_monali_batch18_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azure-sql-monali-batch18.database.windows.net"
		},
		"ls_source_db_monali_batch18_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azure-db-monali-batch18"
		},
		"ls_source_db_monali_batch18_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "monaligothi1303"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfmonalibatch18_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_monali_batch18_accountKey": {
						"value": "[parameters('ls_adls_monali_batch18_accountKey')]"
					},
					"ls_source_db_monali_batch18_password": {
						"value": "[parameters('ls_source_db_monali_batch18_password')]"
					},
					"ls_adls_monali_batch18_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_monali_batch18_properties_typeProperties_url')]"
					},
					"ls_source_db_monali_batch18_properties_typeProperties_server": {
						"value": "[parameters('ls_source_db_monali_batch18_properties_typeProperties_server')]"
					},
					"ls_source_db_monali_batch18_properties_typeProperties_database": {
						"value": "[parameters('ls_source_db_monali_batch18_properties_typeProperties_database')]"
					},
					"ls_source_db_monali_batch18_properties_typeProperties_userName": {
						"value": "[parameters('ls_source_db_monali_batch18_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}