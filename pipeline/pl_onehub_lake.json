{
	"name": "pl_onehub_lake",
	"properties": {
		"activities": [
			{
				"name": "Get Metadata to get files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_onehub_lake_copy_to_silver",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadata to get files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata to get files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(variables('RequiredFiles'), item().name)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach to copy filtered files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter files').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data from source to silver",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_source_onehub_lake_copy_filter_to_silver",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_target_onehub_lake_copy_to_silver",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			},
			{
				"name": "Validation to check silver folder not empty",
				"type": "Validation",
				"dependsOn": [
					{
						"activity": "ForEach to copy filtered files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_target_onehub_lake_copy_to_silver",
						"type": "DatasetReference"
					},
					"timeout": "0.00:05:00",
					"sleep": 10,
					"childItems": true
				}
			},
			{
				"name": "Fail for silver empty",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Validation to check silver folder not empty",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [
					{
						"name": "Email",
						"value": "monalipatel.monali@gmail.com"
					}
				],
				"typeProperties": {
					"message": "No files in silver folder",
					"errorCode": "404"
				}
			},
			{
				"name": "Get Metadata to get target silver files",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Validation to check silver folder not empty",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_onehub_lake_copy_gold",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach to filter largest",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Metadata to get target silver files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata to get target silver files').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Get Metadata to get filesize",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_source_onehub_get_largest_file",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"size",
									"itemName"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						},
						{
							"name": "If Condition to compare filesize",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Metadata to get filesize",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('Get Metadata to get filesize').output.size, variables('LargestFileSize'))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Set variable for largest file name",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "LargestFileName",
											"value": {
												"value": "@activity('Get Metadata to get filesize').output.itemName",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Copy data largest file to gold",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "ForEach to filter largest",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_source_copy_largest_file_to_gold",
						"type": "DatasetReference",
						"parameters": {
							"filename": {
								"value": "@variables('LargestFileName')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_target_copy_largest_file_to_gold",
						"type": "DatasetReference"
					}
				]
			}
		],
		"variables": {
			"RequiredFiles": {
				"type": "String",
				"defaultValue": "[   \"MARA.csv\",   \"VBRK.csv\",   \"VBAP.csv\" ]"
			},
			"LargestFileName": {
				"type": "String"
			},
			"LargestFileSize": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"annotations": []
	}
}