{
	"name": "PL_SAP_Medallion_E2E",
	"properties": {
		"description": "End-to-end: simulated SAP source -> bronze (raw) -> silver (30-day rolling, 1 file/table) -> gold (single largest file). Runs entirely in ADF; the 30-day filter and single-file write use a Mapping Data Flow, no external Databricks workspace required.",
		"activities": [
			{
				"name": "Stage1_ForEach_Source_To_Bronze",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('TableList')",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 3,
					"activities": [
						{
							"name": "Copy_Table_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFolderPath": {
											"value": "source/@{item()}",
											"type": "Expression"
										},
										"wildcardFileName": "*.csv"
									}
								},
								"enableStaging": false,
								"additionalColumns": [
									{
										"name": "ingestion_ts",
										"value": "@utcnow()"
									},
									{
										"name": "source_system",
										"value": "SAP_SIM"
									},
									{
										"name": "source_table",
										"value": "@item()"
									},
									{
										"name": "batch_id",
										"value": "@pipeline().RunId"
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Stage2_ForEach_Bronze_To_Silver",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Stage1_ForEach_Source_To_Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('TableList')",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 3,
					"activities": [
						{
							"name": "DF_Filter_Last_30_Days",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine",
								"parameters": {
									"tableName": {
										"value": "@item()",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Get_Size_MARA",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Stage2_ForEach_Bronze_To_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"fieldList": [
						"size"
					]
				},
				"dataset": {
					"referenceName": "DS_Silver_Csv_Table",
					"type": "DatasetReference",
					"parameters": {
						"table": "MARA"
					}
				}
			},
			{
				"name": "Get_Size_VBAK",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Stage2_ForEach_Bronze_To_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"fieldList": [
						"size"
					]
				},
				"dataset": {
					"referenceName": "DS_Silver_Csv_Table",
					"type": "DatasetReference",
					"parameters": {
						"table": "VBAK"
					}
				}
			},
			{
				"name": "Get_Size_VBRP",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Stage2_ForEach_Bronze_To_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"fieldList": [
						"size"
					]
				},
				"dataset": {
					"referenceName": "DS_Silver_Csv_Table",
					"type": "DatasetReference",
					"parameters": {
						"table": "VBRP"
					}
				}
			},
			{
				"name": "Set_SizeMara",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get_Size_MARA",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SizeMara",
					"value": {
						"value": "@activity('Get_Size_MARA').output.size",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_SizeVbak",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get_Size_VBAK",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SizeVbak",
					"value": {
						"value": "@activity('Get_Size_VBAK').output.size",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_SizeVbrp",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get_Size_VBRP",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SizeVbrp",
					"value": {
						"value": "@activity('Get_Size_VBRP').output.size",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_LargestTable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_SizeMara",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_SizeVbak",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_SizeVbrp",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "LargestTable",
					"value": {
						"value": "@if(and(greaterOrEquals(variables('SizeVbrp'), variables('SizeVbak')), greaterOrEquals(variables('SizeVbrp'), variables('SizeMara'))), 'VBRP', if(greaterOrEquals(variables('SizeVbak'), variables('SizeMara')), 'VBAK', 'MARA'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Stage3_Copy_Largest_To_Gold",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set_LargestTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				}
			}
		],
		"parameters": {
			"RunDate": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcnow(),'yyyy-MM-dd')"
			}
		},
		"variables": {
			"TableList": {
				"type": "Array",
				"defaultValue": [
					"MARA",
					"VBAK",
					"VBRP"
				]
			},
			"SizeMara": {
				"type": "Integer",
				"defaultValue": 0
			},
			"SizeVbak": {
				"type": "Integer",
				"defaultValue": 0
			},
			"SizeVbrp": {
				"type": "Integer",
				"defaultValue": 0
			},
			"LargestTable": {
				"type": "String"
			}
		},
		"annotations": [
			"education",
			"medallion",
			"sap-source",
			"adf-only"
		]
	}
}