{
	"name": "pl_onehub_sql_to_source_sql",
	"properties": {
		"activities": [
			{
				"name": "Filter files for SQL",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadata to get files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata to get files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(variables('FilterFilesForSQL'), item().name)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach to copy filtered file into sql",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter files for SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter files for SQL').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data from adls to SQL",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate",
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_source_copy_source_file_to_sql",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_target_copy_source_file_to_sql",
									"type": "DatasetReference",
									"parameters": {
										"tablename": {
											"value": "@replace(item().name,'.csv','')",
											"type": "Expression"
										},
										"schemaname": {
											"value": "@variables('schemaname')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Set variable for TableName",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy data from adls to SQL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "tablename",
								"value": {
									"value": "@replace(item().name,'.csv','')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Stored procedure to update the watermark table",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Set variable for TableName",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[onehub_write_watermark]",
								"storedProcedureParameters": {
									"last_updated": {
										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"type": "Datetime"
									},
									"tableName": {
										"value": {
											"value": "@variables('tablename')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_source_db_monali_batch18",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Get Metadata to get files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_onehub_lake_copy_to_silver",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"variables": {
			"schemaname": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"FilterFilesForSQL": {
				"type": "Array",
				"defaultValue": [
					"invoice_line_item.csv",
					"costlist.csv",
					"producing_stat_ratio_detail.csv"
				]
			},
			"tablename": {
				"type": "String"
			}
		},
		"annotations": []
	}
}