									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_aa_source_copy_csv_sap",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_aa_target_copy_to_source_sql",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			}
		],
		"folder": {
			"name": "Onehub lake"
		},
		"annotations": []
	}
